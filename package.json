{
  "name": "blog-ia",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "migrate:up": "node --env-file=.env.local node_modules/.bin/postgrator migrate",
    "migrate:down": "node --env-file=.env.local node_modules/.bin/postgrator migrate 0",
    "infra:up": "podman compose up -d",
    "infra:down": "podman compose down",
    "docker:build": "podman build -t blog-ia:latest .",
    "docker:run": "podman run --rm --name blog-api --network blog-network -p 3333:3333 -e DATABASE_URL=postgresql://postgres:postgres@blog-postgres:5432/blog -e API_KEY=${API_KEY:CHAVESUPERSECRETA} blog-ia:latest",
    "test": "node --test --test-concurrency=1 --experimental-test-module-mocks \"test/**/*.test.js\"",
    "test:unit": "node --test --experimental-test-module-mocks \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --experimental-test-module-mocks \"test/e2e/**/*.test.js\"",
    "test:watch": "node --test --watch --experimental-test-module-mocks \"test/unit/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-module-mocks --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mastra/core": "^1.74.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "postgrator": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postgrator-cli": "^10.0.0",
    "supertest": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  }
}
